# ─────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.swp
*.swo
.scratch/
tmp/

# ─────────────────────────────────────────────
# ──  WHAT IS TRACKED (kept in Git)  ──────────
#
#   notebooks/**/*.ipynb       all Jupyter notebooks
#   src/**/*.py                source modules
#   reports/**/*.md            markdown reports
#   requirements.txt           dependency list
#   README.md                  project documentation
#   .gitignore                 this file
#   models/**/                 directory structure only
#                              (artifacts themselves are excluded above)
# ─────────────────────────────────────────────

# Keep empty model subdirectories tracked via placeholder
!models/.gitkeep
!models/regression/.gitkeep
!models/clustering/.gitkeep
!models/recommendation/.gitkeep
!models/hybrid/.gitkeep

# Keep report markdown files even if their parent dirs are partially ignored
!reports/figures/*.md
!reports/results/*.md
