# ─────────────────────────────────────────────
# Machine learning model artifacts
# (large binary files — stored outside Git or via DVC)
# ─────────────────────────────────────────────
models/**/*.joblib
models/**/*.pkl
models/**/*.pickle
models/**/*.npy
models/**/*.npz
models/**/*.h5
models/**/*.pt
models/**/*.pth
models/**/*.onnx

# ─────────────────────────────────────────────
# Data files
# (raw and processed datasets — too large for Git)
# ─────────────────────────────────────────────

*.csv
*.tsv
*.parquet
*.feather
*.hdf
*.h5

# ─────────────────────────────────────────────
# Logs and output files
# ─────────────────────────────────────────────
logs/
*.log
*.out
*.err
log.txt

# ─────────────────────────────────────────────
# Reports / generated figures
# (keep source .md files; ignore generated images)
# ─────────────────────────────────────────────
reports/figures/*.png
reports/figures/*.jpg
reports/figures/*.jpeg
reports/figures/*.svg
reports/figures/*.pdf
reports/results/*.csv
reports/results/*.json

