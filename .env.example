# =============================================================================
# ADV_ML_02 — Chatbot environment variables
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Gemini (existing — used by 03_Gemini_Function_Calling.ipynb)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# -----------------------------------------------------------------------------
# OpenAI-compatible (Groq / OpenRouter — used by 04_LLMClient_Groq.ipynb)
# -----------------------------------------------------------------------------

# Provider: "groq" or "openrouter"
LLM_PROVIDER=groq

# Model identifier (provider-specific):
#   Groq examples      : llama-3.3-70b-versatile, llama-3.1-8b-instant,
#                        mixtral-8x7b-32768, gemma2-9b-it
#   OpenRouter examples: openai/gpt-4o-mini, meta-llama/llama-3-70b-instruct,
#                        google/gemma-3-27b-it
LLM_MODEL=openai/gpt-oss-120b

# Groq API key (get yours at https://console.groq.com/keys)
GROQ_API_KEY=

# OpenRouter API key (get yours at https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: override the base URL (leave empty to use provider default)
# LLM_BASE_URL=

